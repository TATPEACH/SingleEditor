# Public Windows device bindings without changing shared JUCE.
include("${CMAKE_CURRENT_LIST_DIR}/SingleEditorJuceAsioClock.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SingleEditorJuceAsioEvents.cmake")
option(SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING "Read exact active WASAPI endpoint for explicit diagnostics" ON)
function(single_editor_configure_juce_audio_diagnostics)
    if(NOT WIN32)
        return()
    endif()
    get_target_property(audio_sources juce_audio_devices INTERFACE_SOURCES)
    set(amalgamations)
    foreach(source IN LISTS audio_sources)
        if(source MATCHES "/juce_audio_devices\\.cpp$")
            list(APPEND amalgamations "${source}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES amalgamations)
    list(LENGTH amalgamations count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Single Editor expects one JUCE audio-device amalgamation")
    endif()
    list(GET amalgamations 0 amalgamation)
    get_filename_component(audio_root "${amalgamation}" DIRECTORY)
    set(wasapi "${audio_root}/native/juce_WASAPI_windows.cpp")
    set(asio "${audio_root}/native/juce_ASIO_windows.cpp")
    foreach(part amalgamation wasapi asio)
        file(READ "${${part}}" contents)
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(SHA256 ${part}_hash "${contents}")
    endforeach()
    if(NOT amalgamation_hash STREQUAL "6c8afe3765d9099c4162c7f7df4c60d9e93a4e673e2a63efaf0b56a2b75287e7")
        message(FATAL_ERROR "JUCE amalgamation differs from reviewed 8.0.12 Windows device bindings")
    endif()
    if(SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING AND NOT wasapi_hash STREQUAL "ab90c307832e59d405215fea80a91f5ec3d332d1ee8eabef39eeeb32a6108ba4")
        message(FATAL_ERROR "JUCE differs from reviewed 8.0.12 WASAPI binding. Review binding or explicitly set SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING=OFF.")
    endif()
    if(NOT asio_hash STREQUAL "6e10ea3d0056a363b670f2c6f05ba10d3233eb4d2eec14f5677167bd7b8db8d1")
        message(FATAL_ERROR "JUCE ASIO differs from reviewed 8.0.12 public constructor binding")
    endif()
    set(binding "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Source/Audio/NativeAudioDeviceBinding.cpp.inc")
    set(asio_binding "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Source/Audio/NativeAsioDevice.cpp.inc")
    set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/single-editor-juce-audio/juce_audio_devices.cpp")
    set(driver_fixture "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Tests/AsioDriverHook.h")
    # Intercept only ASIO's one driver-creation call in the dedicated test.
    # A global CoCreateInstance macro would also rename ComSmartPtr methods.
    file(READ "${asio}" asio_contents)
    single_editor_patch_asio_clock(asio_contents asio_contents)
    single_editor_patch_asio_events(asio_contents asio_contents)
    string(REPLACE "return CoCreateInstance (classId, 0, CLSCTX_INPROC_SERVER,"
        "return SINGLE_EDITOR_CREATE_ASIO_DRIVER (classId, 0, CLSCTX_INPROC_SERVER," asio_contents "${asio_contents}")
    set(asio_prefix "#if SINGLE_EDITOR_ASIO_DRIVER_FIXTURE\n#include \"${driver_fixture}\"\n#define SINGLE_EDITOR_CREATE_ASIO_DRIVER singleeditor::tests::createDriverInstance\n#else\n#define SINGLE_EDITOR_CREATE_ASIO_DRIVER CoCreateInstance\n#endif\n")
    set(asio_contents "#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Source/Audio/NativeAsioDevice.h\"\n#include <cmath>\n${asio_prefix}${asio_contents}\n#undef SINGLE_EDITOR_CREATE_ASIO_DRIVER\n")
    set(local_asio "${CMAKE_CURRENT_BINARY_DIR}/single-editor-juce-audio/juce_ASIO_windows.cpp")
    set(local_amalgamation "${CMAKE_CURRENT_BINARY_DIR}/single-editor-juce-audio/juce_audio_devices_amalgamation.cpp")
    file(READ "${amalgamation}" amalgamation_contents)
    string(REPLACE "\"native/juce_ASIO_windows.cpp\"" "\"${local_asio}\"" amalgamation_contents "${amalgamation_contents}")
    foreach(local_file IN ITEMS asio amalgamation)
        set(previous "")
        if(EXISTS "${local_${local_file}}")
            file(READ "${local_${local_file}}" previous)
        endif()
        if(NOT previous STREQUAL ${local_file}_contents)
            file(WRITE "${local_${local_file}}" "${${local_file}_contents}")
        endif()
    endforeach()
    target_include_directories(juce_audio_devices INTERFACE "${audio_root}")
    set(contents "#include \"${local_amalgamation}\"\n#include \"${asio_binding}\"\n")
    if(SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING)
        string(APPEND contents "#include \"${binding}\"\n")
    endif()
    set(previous "")
    if(EXISTS "${wrapper}")
        file(READ "${wrapper}" previous)
    endif()
    if(NOT previous STREQUAL contents)
        file(WRITE "${wrapper}" "${contents}")
    endif()
    set(mapped_sources)
    foreach(source IN LISTS audio_sources)
        if(source STREQUAL amalgamation)
            list(APPEND mapped_sources "${wrapper}")
        else()
            list(APPEND mapped_sources "${source}")
        endif()
    endforeach()
    set_property(TARGET juce_audio_devices PROPERTY INTERFACE_SOURCES "${mapped_sources}")
    if(SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING)
        target_compile_definitions(juce_audio_devices INTERFACE SINGLE_EDITOR_WASAPI_DIAGNOSTIC_BINDING=1)
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${amalgamation}" "${wasapi}" "${asio}")
    message(STATUS "Single Editor: build-local Windows bindings and ASIO stable-clock overlay; shared JUCE unchanged")
endfunction()
