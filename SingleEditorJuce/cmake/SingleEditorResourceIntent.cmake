function(single_editor_write_resource_intent)
    if(NOT WIN32)
        return()
    endif()
    set(RESOURCE_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
    set(RESOURCE_BUILD_ROOT "${CMAKE_CURRENT_BINARY_DIR}")
    set(RESOURCE_VERSION "${PROJECT_VERSION}")
    set(RESOURCE_ARCHITECTURE "${CMAKE_GENERATOR_PLATFORM}")
    if(RESOURCE_ARCHITECTURE STREQUAL "")
        set(RESOURCE_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    set(RESOURCE_TRAY_ICON "${SINGLE_EDITOR_TRAY_ICON_SOURCE}")
    set(RESOURCE_TRAY_PACK "${SINGLE_EDITOR_TRAY_PACK}")
    set(RESOURCE_ICON_RC "${CMAKE_CURRENT_SOURCE_DIR}/Resources/SingleEditor.rc")
    # The RC is the source of the native icon name and filename. Do not maintain
    # a second manually enumerated list of generated RT_ICON frame IDs.
    file(READ "${RESOURCE_ICON_RC}" icon_rc)
    string(REGEX MATCHALL "[A-Za-z_][A-Za-z_0-9]*[ \t]+ICON[ \t]+\"[^\"]+\"" icon_entries "${icon_rc}")
    list(LENGTH icon_entries icon_count)
    if(NOT icon_count EQUAL 1)
        message(FATAL_ERROR "Review native icon ownership: expected one declared ICON resource")
    endif()
    list(GET icon_entries 0 icon_entry)
    string(REGEX MATCH "^([A-Za-z_][A-Za-z_0-9]*)[ \t]+ICON[ \t]+\"([^\"]+)\"$" ignored "${icon_entry}")
    set(RESOURCE_ICON_NAME "${CMAKE_MATCH_1}")
    get_filename_component(icon_directory "${RESOURCE_ICON_RC}" DIRECTORY)
    get_filename_component(RESOURCE_NATIVE_ICON "${CMAKE_MATCH_2}" ABSOLUTE BASE_DIR "${icon_directory}")
    foreach(pair IN ITEMS "GUI;SingleEditor" "CLI;SingleEditorCLI")
        list(GET pair 0 role)
        list(GET pair 1 product)
        get_target_property(RESOURCE_${role}_PRODUCT_NAME ${product} JUCE_PRODUCT_NAME)
        get_target_property(rc_sources ${product}_rc_lib SOURCES)
        set(found FALSE)
        foreach(rc_source IN LISTS rc_sources)
            if(rc_source MATCHES "\\.rc$")
                if(found)
                    message(FATAL_ERROR "Review generated version resource ownership for ${product}")
                endif()
                set(found TRUE)
                set(RESOURCE_${role}_VERSION_SOURCE "${rc_source}")
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Generated version resource source missing for ${product}")
        endif()
    endforeach()
    foreach(resource IN ITEMS TRAY_ICON ICON_RC NATIVE_ICON)
        file(SHA256 "${RESOURCE_${resource}}" RESOURCE_${resource}_SHA256)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RESOURCE_${resource}}")
    endforeach()
    # Configured ownership is intent. The observer checks actual linked/native
    # bytes and the matching owner pack in the selected complete payload.
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ResourceIntent.json.in"
        "${CMAKE_CURRENT_BINARY_DIR}/resource-intent/configured.json" @ONLY)
    file(READ "${CMAKE_CURRENT_BINARY_DIR}/resource-intent/configured.json" resource_intent)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/resource-intent/$<CONFIG>.json"
        CONTENT "${resource_intent}")
endfunction()
