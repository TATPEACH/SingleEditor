# Derive only path coordinates, never business ownership or lifecycle. This also
# handles the configured shared checkout versus FetchContent/overlay locations.
function(single_editor_code_source_coordinates absolute output_source output_base)
    get_filename_component(absolute "${absolute}" ABSOLUTE)
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_BINARY_DIR}" "${absolute}")
    if(NOT relative MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${relative}")
        set(base build)
    else()
        file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${absolute}")
        if(NOT relative MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${relative}")
            set(base project)
        else()
            set(base external)
            set(relative "${absolute}")
        endif()
    endif()
    set(${output_source} "${relative}" PARENT_SCOPE)
    set(${output_base} "${base}" PARENT_SCOPE)
endfunction()

# Build-only declarations beside the source roles. Mixed translation units use
# scope/member selectors; homogeneous units may explicitly own their whole source.
function(single_editor_declare_code_unit)
    cmake_parse_arguments(PARSE_ARGV 0 UNIT "WHOLE_SOURCE" "ID;OWNER;LIFECYCLE;SOURCE;SOURCE_BASE;TRIGGER;RETENTION"
        "SCOPES;MEMBERS;PDB_CLASSES;PDB_FUNCTIONS;PDB_METHODS;PDB_VFTABLE_CLASSES;INCLUDED_DEFINITIONS;TARGETS")
    if(UNIT_UNPARSED_ARGUMENTS OR UNIT_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Unexpected or missing code intent arguments: ${UNIT_ID}")
    endif()
    foreach(field IN ITEMS ID OWNER LIFECYCLE SOURCE TRIGGER RETENTION TARGETS)
        if(NOT UNIT_${field})
            message(FATAL_ERROR "Code intent requires ${field}")
        endif()
    endforeach()
    if(NOT UNIT_SOURCE_BASE)
        set(UNIT_SOURCE_BASE project)
    endif()
    if(NOT UNIT_SOURCE_BASE MATCHES "^(project|build|external)$")
        message(FATAL_ERROR "Unsupported code source base: ${UNIT_ID}")
    endif()
    if(UNIT_SOURCE_BASE STREQUAL "external")
        if(NOT IS_ABSOLUTE "${UNIT_SOURCE}")
            message(FATAL_ERROR "External code source requires an absolute path: ${UNIT_ID}")
        endif()
    elseif(IS_ABSOLUTE "${UNIT_SOURCE}" OR UNIT_SOURCE MATCHES "(^|/)\\.\\.?(/|$)")
        message(FATAL_ERROR "Project/build code source requires a root-relative path: ${UNIT_ID}")
    endif()
    if(UNIT_WHOLE_SOURCE AND (UNIT_SCOPES OR UNIT_MEMBERS OR UNIT_PDB_CLASSES OR UNIT_PDB_FUNCTIONS OR UNIT_PDB_METHODS OR UNIT_PDB_VFTABLE_CLASSES))
        message(FATAL_ERROR "Code intent WHOLE_SOURCE excludes SCOPES/MEMBERS/PDB_CLASSES/PDB_FUNCTIONS/PDB_METHODS/PDB_VFTABLE_CLASSES: ${UNIT_ID}")
    elseif(NOT UNIT_WHOLE_SOURCE AND NOT UNIT_SCOPES AND NOT UNIT_MEMBERS AND NOT UNIT_PDB_CLASSES AND NOT UNIT_PDB_FUNCTIONS AND NOT UNIT_PDB_METHODS)
        message(FATAL_ERROR "Code intent requires WHOLE_SOURCE, SCOPES, MEMBERS, PDB_CLASSES, PDB_FUNCTIONS or PDB_METHODS: ${UNIT_ID}")
    endif()
    if(UNIT_WHOLE_SOURCE AND UNIT_INCLUDED_DEFINITIONS)
        message(FATAL_ERROR "Included definitions require explicit callable selectors: ${UNIT_ID}")
    endif()
    set(whole_source false)
    if(UNIT_WHOLE_SOURCE)
        set(whole_source true)
    endif()
    get_property(previous_units GLOBAL PROPERTY SINGLE_EDITOR_CODE_INTENT_UNITS)
    foreach(previous IN LISTS previous_units)
        string(JSON previous_id GET "${previous}" id)
        if(previous_id STREQUAL UNIT_ID)
            message(FATAL_ERROR "Duplicate code intent ID: ${UNIT_ID}")
        endif()
        string(JSON previous_source GET "${previous}" source)
        string(JSON previous_base GET "${previous}" source_base)
        string(JSON previous_whole GET "${previous}" whole_source)
        if(previous_source STREQUAL UNIT_SOURCE AND previous_base STREQUAL UNIT_SOURCE_BASE AND (previous_whole OR UNIT_WHOLE_SOURCE))
            string(JSON count LENGTH "${previous}" targets)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON target GET "${previous}" targets ${index})
                if(target IN_LIST UNIT_TARGETS)
                    message(FATAL_ERROR "Whole-source code intent overlap: ${UNIT_ID} / ${previous_id}")
                endif()
            endforeach()
        endif()
    endforeach()
    # Project-owned literals only. Keep the generated JSON unambiguous.
    foreach(value IN ITEMS "${UNIT_ID}" "${UNIT_OWNER}" "${UNIT_LIFECYCLE}"
            "${UNIT_SOURCE}" "${UNIT_TRIGGER}" "${UNIT_RETENTION}" ${UNIT_SCOPES} ${UNIT_MEMBERS} ${UNIT_PDB_CLASSES} ${UNIT_PDB_FUNCTIONS} ${UNIT_PDB_METHODS} ${UNIT_PDB_VFTABLE_CLASSES} ${UNIT_TARGETS})
        if(value MATCHES "[;\"\\\\\n\r]")
            message(FATAL_ERROR "Unsupported character in code intent: ${UNIT_ID}")
        endif()
    endforeach()
    set(scopes "[]")
    if(UNIT_SCOPES)
        list(JOIN UNIT_SCOPES "\", \"" scopes)
        set(scopes "[\"${scopes}\"]")
    endif()
    set(members "[]")
    if(UNIT_MEMBERS)
        list(JOIN UNIT_MEMBERS "\", \"" members)
        set(members "[\"${members}\"]")
    endif()
    list(JOIN UNIT_TARGETS "\", \"" targets)
    set(unit "{\"id\":\"${UNIT_ID}\",\"owner\":\"${UNIT_OWNER}\",\"lifecycle\":\"${UNIT_LIFECYCLE}\",\"source\":\"${UNIT_SOURCE}\",\"source_base\":\"${UNIT_SOURCE_BASE}\",\"whole_source\":${whole_source},\"scopes\":${scopes},\"members\":${members},\"targets\":[\"${targets}\"],\"earliest_trigger\":\"${UNIT_TRIGGER}\",\"retention\":\"${UNIT_RETENTION}\"}")
    # Exact DIA class-parent spellings, not prefix patterns or MAP selectors.
    # Omit the field on existing declarations to preserve their representation.
    if(UNIT_PDB_CLASSES)
        list(JOIN UNIT_PDB_CLASSES "\", \"" pdb_classes)
        string(JSON unit SET "${unit}" pdb_classes "[\"${pdb_classes}\"]")
    endif()
    # Exact observed free-template function names. Never parse template arguments
    # or use this field to infer a class/scope from MAP mangling.
    if(UNIT_PDB_FUNCTIONS)
        list(JOIN UNIT_PDB_FUNCTIONS "\", \"" pdb_functions)
        string(JSON unit SET "${unit}" pdb_functions "[\"${pdb_functions}\"]")
    endif()
    # Exact observed method names require a real DIA/IPI class parent. Selecting
    # one method never selects the rest of its template class or a free function.
    if(UNIT_PDB_METHODS)
        list(JOIN UNIT_PDB_METHODS "\", \"" pdb_methods)
        string(JSON unit SET "${unit}" pdb_methods "[\"${pdb_methods}\"]")
    endif()
    # Explicit definition files extend only this unit's callable selectors.
    # They are not compiled sources or whole-file ownership. The release ledger
    # additionally requires the same build's pre-capture and CL.read proof.
    if(UNIT_INCLUDED_DEFINITIONS)
        set(definitions "[]")
        set(definition_index 0)
        set(seen_definitions)
        foreach(definition IN LISTS UNIT_INCLUDED_DEFINITIONS)
            if(NOT IS_ABSOLUTE "${definition}" OR NOT EXISTS "${definition}"
                OR definition MATCHES "[;\"\\\\\n\r]")
                message(FATAL_ERROR "Included definition requires an exact existing absolute file: ${UNIT_ID}")
            endif()
            single_editor_code_source_coordinates("${definition}" definition_source definition_base)
            if(definition IN_LIST seen_definitions
                OR (definition_source STREQUAL UNIT_SOURCE AND definition_base STREQUAL UNIT_SOURCE_BASE))
                message(FATAL_ERROR "Duplicate included definition: ${UNIT_ID}/${definition}")
            endif()
            list(APPEND seen_definitions "${definition}")
            file(SHA256 "${definition}" definition_hash)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${definition}")
            string(JSON definitions SET "${definitions}" ${definition_index}
                "{\"source\":\"${definition_source}\",\"source_base\":\"${definition_base}\",\"source_sha256\":\"${definition_hash}\"}")
            math(EXPR definition_index "${definition_index} + 1")
        endforeach()
        string(JSON unit SET "${unit}" included_definitions "${definitions}")
    endif()
    # Explicit primary-vftable storage only: exact class/unique-name pairs.
    # Existing callable selectors cannot stand in for the same-unit SCOPES contract.
    if(UNIT_PDB_VFTABLE_CLASSES)
        list(LENGTH UNIT_PDB_VFTABLE_CLASSES count)
        math(EXPR odd "${count} % 2")
        if(odd)
            message(FATAL_ERROR "PDB_VFTABLE_CLASSES requires class/unique-name pairs: ${UNIT_ID}")
        endif()
        set(vftable_classes "[]")
        set(seen_classes)
        set(seen_unique_names)
        math(EXPR last "${count} - 2")
        foreach(index RANGE 0 ${last} 2)
            math(EXPR unique_index "${index} + 1")
            list(GET UNIT_PDB_VFTABLE_CLASSES ${index} class_name)
            list(GET UNIT_PDB_VFTABLE_CLASSES ${unique_index} class_unique_name)
            set(class_scope_match false)
            foreach(class_scope IN LISTS UNIT_SCOPES)
                string(FIND "${class_name}" "${class_scope}::" class_scope_prefix)
                if(class_name STREQUAL class_scope OR class_scope_prefix EQUAL 0)
                    set(class_scope_match true)
                endif()
            endforeach()
            if(NOT class_scope_match)
                message(FATAL_ERROR "PDB_VFTABLE_CLASSES requires existing same-unit SCOPES coverage: ${UNIT_ID}/${class_name}")
            endif()
            if(NOT class_unique_name MATCHES "^\\.\\?A[UV][A-Za-z_?][A-Za-z_0-9?$@]*@@$")
                message(FATAL_ERROR "Unsupported vftable unique class name: ${UNIT_ID}")
            endif()
            if(class_name IN_LIST seen_classes OR class_unique_name IN_LIST seen_unique_names)
                message(FATAL_ERROR "Duplicate PDB_VFTABLE_CLASSES entry: ${UNIT_ID}")
            endif()
            list(APPEND seen_classes "${class_name}")
            list(APPEND seen_unique_names "${class_unique_name}")
            math(EXPR output_index "${index} / 2")
            string(JSON vftable_classes SET "${vftable_classes}" ${output_index}
                "{\"class_name\":\"${class_name}\",\"class_unique_name\":\"${class_unique_name}\"}")
        endforeach()
        string(JSON unit SET "${unit}" vftable_classes "${vftable_classes}")
    endif()
    set_property(GLOBAL APPEND PROPERTY SINGLE_EDITOR_CODE_INTENT_UNITS "${unit}")
endfunction()

function(single_editor_write_code_intent)
    if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        return()
    endif()
    get_property(units GLOBAL PROPERTY SINGLE_EDITOR_CODE_INTENT_UNITS)
    set(CODE_INTENT_VERSION 7)
    set(CODE_INTENT_COMPILER_DATA_FIELD "")
    set(CODE_INTENT_INLINE_DEFINITION_FIELD "")
    set(checked_units)
    foreach(unit IN LISTS units)
        string(JSON selector_type ERROR_VARIABLE selector_error TYPE "${unit}" vftable_classes)
        if(NOT selector_error)
            if(CODE_INTENT_VERSION LESS 8)
                set(CODE_INTENT_VERSION 8)
            endif()
            set(CODE_INTENT_COMPILER_DATA_FIELD "  \"compiler_data_policy\": \"msvc-x64-primary-vftable-v1\",\n")
        endif()
        string(JSON definition_type ERROR_VARIABLE definition_error TYPE "${unit}" included_definitions)
        if(NOT definition_error)
            set(CODE_INTENT_VERSION 9)
            set(CODE_INTENT_INLINE_DEFINITION_FIELD "  \"inline_definition_policy\": \"explicit-included-inline-definitions-v1\",\n")
        endif()
        string(JSON source GET "${unit}" source)
        string(JSON source_base GET "${unit}" source_base)
        string(JSON count LENGTH "${unit}" targets)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON target GET "${unit}" targets ${index})
            get_target_property(target_sources ${target} SOURCES)
            if(source_base STREQUAL "project" AND NOT source IN_LIST target_sources)
                message(FATAL_ERROR "Code intent source ${source} is not in ${target}")
            endif()
        endforeach()
        if(source_base STREQUAL "project")
            set(source_path "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
        elseif(source_base STREQUAL "build")
            set(source_path "${CMAKE_CURRENT_BINARY_DIR}/${source}")
        else()
            set(source_path "${source}")
        endif()
        # Inherited JUCE sources and linked library producers are verified by
        # actual compile/archive/link observations, not the direct SOURCES list.
        file(SHA256 "${source_path}" source_hash)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_path}")
        string(JSON unit SET "${unit}" source_sha256 "\"${source_hash}\"")
        list(APPEND checked_units "${unit}")
    endforeach()
    list(JOIN checked_units ",\n" CODE_INTENT_UNITS)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt" CODE_INTENT_DECLARATION_SHA256)
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" CODE_INTENT_GENERATOR_SHA256)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CodeIntent.json.in"
        "${CMAKE_CURRENT_BINARY_DIR}/code-intent/configured.json" @ONLY)
    file(READ "${CMAKE_CURRENT_BINARY_DIR}/code-intent/configured.json" content)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/code-intent/$<CONFIG>.json" CONTENT "${content}")
endfunction()
