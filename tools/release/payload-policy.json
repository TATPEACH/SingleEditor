  "budget_basis": "The 64 KiB Ambisonics owner pack and its independent NOTICE retain the v5 limits. The v6 compiled-dependency-notices group has a fixed 128 KiB DistributionOnly allowance for selected JUCE/ASIO and embedded Phosphor icon notices, complete GPL/AGPL texts and their source index. The separate runtime-dependency-notices group has a fixed 128 KiB allowance for the retained r2083 codec notice set and its exact archive/source index; unresolved source delivery and G719 terms remain explicit. Neither addition enlarges the existing 4 KiB license or Ambisonics notice groups. Executable/runtime, core icon and tray ceilings remain unchanged. Source-side tool notices and the icon mapping are retained outside the executable payload through explicit source exclusions. These engineering file budgets do not substitute for D171 final calibrated package/linked owner/class budgets or runtime evidence; the new notice metrics require final calibration with the selected release. Sealed older stages retain their own policy.",
  "groups": [
    {
      "id": "window-shell-tray",
      "owner": "singleeditor.window-shell",
      "kind": "owner-resource-pack",
      "declared_loading_policy": "PostCoreWorkspace; explicit close-to-tray and current document CoreReady; released on restore or quit",
      "max_bytes": 262144
    },
    {
      "id": "gui",
      "owner": "application",
      "kind": "executable",
      "declared_loading_policy": "application entry; optional code remains governed by its runtime trigger",
      "max_bytes": 12582912,
      "machine": "x64",
      "max_image_bytes": 12582912,
      "max_direct_imports": 34
    },
    {
      "id": "cli",
      "owner": "automation",
      "kind": "executable",
      "declared_loading_policy": "explicit external command",
      "max_bytes": 4194304,
      "machine": "x64",
      "max_image_bytes": 4194304,
      "max_direct_imports": 22
    },
    {
      "id": "branding",
      "owner": "distribution",
      "kind": "shell-association-icon",
      "declared_loading_policy": "Windows shell file association; GUI action icons are independently embedded",
      "max_bytes": 524288
    },
    {
      "id": "license",
      "owner": "distribution",
      "kind": "license",
      "declared_loading_policy": "disclosure only",
      "max_bytes": 4096
    },
    {
      "id": "compiled-dependency-notices",
      "owner": "distribution",
      "kind": "license",
      "declared_loading_policy": "DistributionOnly; independently inspectable compiled dependency notices, complete license texts and source index",
      "max_bytes": 131072
    },
    {
      "id": "runtime-dependency-notices",
      "owner": "distribution",
      "kind": "license",
      "declared_loading_policy": "DistributionOnly; retained optional-runtime dependency notices and exact archive/source index; unresolved redistribution terms remain explicit",
      "max_bytes": 131072
    },
    {
      "id": "vgmstream",
      "owner": "packed-media",
      "kind": "optional-runtime-pack",
      "declared_loading_policy": "explicit packed-media decode request",
      "max_bytes": 13631488,
      "machine": "x86",
      "max_image_bytes": 18874368
    },
    {
      "id": "vc-runtime",
      "owner": "distribution",
      "kind": "application-local-runtime",
      "declared_loading_policy": "Windows loader; required by GUI and CLI at startup",
      "max_bytes": 1048576,
      "machine": "x64",
      "max_image_bytes": 1048576
    },
    {
      "id": "ambisonic-binaural",
      "owner": "singleeditor.ambisonics",
      "kind": "owner-resource-pack",
      "declared_loading_policy": "ModuleLazy; explicit Ambisonic binaural monitor or CLI route; active document/transport or inspection lease",
      "max_bytes": 65536
    },
    {
      "id": "ambisonic-notice",
      "owner": "distribution",
      "kind": "license",
      "declared_loading_policy": "DistributionOnly; independently inspectable source and license notice",
      "max_bytes": 4096
    }
  ],
